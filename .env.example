# Copy this file to `.env` and fill in the values before running `npm run build`.

# 1) The live domain of the website (no trailing slash). Used for canonical URLs,
#    sitemap.xml, robots.txt, Open Graph tags and structured data.
#    The hospital's Google Business Profile has no website yet — set the real domain here
#    and add the same URL to the Google Business Profile ("Add website").
VITE_SITE_URL=https://www.gurudevhospital.com

# 2) Google Maps Platform browser key — powers the LIVE Google reviews and the map.
#    Enable: "Maps JavaScript API", "Places API (New)" and "Maps Embed API".
#    Restrict the key: Application restriction = Websites (your domain + http://localhost:*),
#    API restriction = the three APIs above.
#    Without a key the site still works: it shows the rating snapshot + links to Google reviews,
#    and a keyless map embed.
VITE_GOOGLE_MAPS_API_KEY=

# 3) Optional: endpoint that receives appointment requests as JSON (POST).
#    Works with Formspree, Web3Forms, Getform, a Google Apps Script web app, or your own API.
#    If empty, the form opens WhatsApp with the request pre-filled to the hospital number.
VITE_FORM_ENDPOINT=

# 4) Optional: Google Search Console HTML-tag verification code (content="...").
VITE_GSC_VERIFICATION=

# 5) Optional: Google Analytics 4 Measurement ID (free). Format: G-XXXXXXXXXX
#    Loads after the page is idle; tracks page views + click_call / click_whatsapp /
#    click_directions / generate_lead events (mark these as Key events in GA4).
VITE_GA_MEASUREMENT_ID=
