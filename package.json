{
  "name": "gurudev-hospital-badlapur",
  "private": true,
  "version": "1.0.0",
  "description": "Official website of Gurudev Multi-Speciality Hospital, Badlapur East — React + Vite with build-time prerendering for SEO.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --port 5177",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-server",
    "build:icons": "node scripts/generate-icons.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "preview": "node scripts/serve.mjs",
    "photos": "node scripts/process-photos.mjs",
    "review-qr": "node scripts/review-qr.mjs",
    "stock": "node scripts/fetch-stock.mjs",
    "doctor-photos": "node scripts/process-doctor-photos.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  }
}
